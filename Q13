<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notes App with localStorage</title>
</head>
<body>

  <h2>Notes App</h2>

  <!-- Text area for entering and displaying notes -->
  <textarea id="notesArea" cols="40" rows="10" placeholder="Write your notes here..."></textarea>
  <br><br>

  <!-- Buttons for Save, Load and Clear operations -->
  <button id="saveBtn">Save Notes</button>
  <button id="loadBtn">Load Notes</button>
  <button id="clearBtn">Clear Notes</button>

  <script>
    // Select DOM elements using IDs
    const notesArea = document.getElementById("notesArea");
    const saveBtn = document.getElementById("saveBtn");
    const loadBtn = document.getElementById("loadBtn");
    const clearBtn = document.getElementById("clearBtn");

    // On page load, automatically retrieve notes from localStorage (if any)
    window.addEventListener("load", function () {
      const storedNotes = localStorage.getItem("userNotes");
      
      // If notes exist, display them inside the textarea
      if (storedNotes) {
        notesArea.value = storedNotes;
      }
    });

    // Save notes button functionality
    saveBtn.addEventListener("click", function () {

      // Trim whitespace to prevent saving empty content
      const notesText = notesArea.value.trim();

      // Validation check: do not allow saving blank notes
      if (notesText === "") {
        alert("Please enter some notes before saving.");
        return;
      }

      // Save note text to localStorage
      localStorage.setItem("userNotes", notesText);
      alert("Notes saved successfully!");
    });

    // Load notes manually using button
    loadBtn.addEventListener("click", function () {
      const storedNotes = localStorage.getItem("userNotes");

      // If notes exist, display them, otherwise show message
      if (storedNotes) {
        notesArea.value = storedNotes;
      } else {
        alert("No saved notes found!");
      }
    });

    // Clear notes button functionality
    clearBtn.addEventListener("click", function () {
      
      // Remove notes from localStorage
      localStorage.removeItem("userNotes");

      // Empty the textarea visually
      notesArea.value = "";

      alert("Notes cleared!");
    });
  </script>

</body>
</html>
